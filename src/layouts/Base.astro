---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Homepage: title is just the name, not "Name — Name". */
  bare?: boolean;
}
const { title, description = SITE.description, bare = false } = Astro.props as Props;

const pageTitle = bare || !title ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
const base = Astro.site ?? new URL(SITE.domain);
const canonical = new URL(Astro.url.pathname, base).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', base).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tejas Wadhwa — hardware meets software" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.name,
      url: base.href,
      email: SITE.email,
      jobTitle: 'Computer Engineering Student',
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Purdue University' },
      knowsAbout: ['FPGA design', 'SystemVerilog', 'Digital signal processing', 'Embedded firmware', 'PCB design'],
      sameAs: [SITE.github, SITE.linkedin],
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
