---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const groups = [
  { key: 'selected', title: 'Finished work', items: all.filter((p) => p.data.tier === 'selected') },
  { key: 'current', title: 'In progress', items: all.filter((p) => p.data.tier === 'current') },
  { key: 'also', title: 'Smaller projects', items: all.filter((p) => p.data.tier === 'also') },
].filter((g) => g.items.length > 0);
---
<Base
  title="Projects"
  description="FPGA, DSP, embedded and PCB projects, written up with the constraints, the decisions, and the numbers."
>
  <section class="wrap page-head">
    <h1>Projects</h1>
    <p class="dek">
      Concise, source-grounded briefs now; longer first-person articles will follow as I write them.
    </p>
  </section>

  <div class="wrap page-body">
    {groups.map((g) => (
      <section class="group">
        <h2>{g.title}</h2>
        <div class="project-grid">
          {g.items.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
