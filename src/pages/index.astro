---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HarmoniCoreDemo from '../components/HarmoniCoreDemo.astro';
import { SITE, AFFILIATIONS, CURRENT_UPDATED } from '../consts';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const selected = all.filter((p) => p.data.tier === 'selected');
const current = all.filter((p) => p.data.tier === 'current');
const also = all.filter((p) => p.data.tier === 'also');
---
<Base bare>
  <section class="wrap statement">
    <h1>I build systems that cross the hardware&#8211;software line.</h1>
    <p class="sub">
      FPGA DSP, embedded firmware, PCB design, and the software that connects them.
      Computer Engineering at Purdue, graduating {SITE.gradDate}.
    </p>

    <dl class="affils">
      {AFFILIATIONS.map((a) => (
        <div class="affil">
          <dt>{a.label}</dt>
          <dd>{a.value}</dd>
        </div>
      ))}
    </dl>

    <div class="statement-contact">
      <img
        class="home-headshot"
        src="/images/headshot.webp"
        alt="Tejas Wadhwa"
        width="72"
        height="72"
      />
      <div class="inline-links">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.github}>GitHub</a>
        <a href={SITE.linkedin}>LinkedIn</a>
      </div>
    </div>
  </section>

  <HarmoniCoreDemo />

  {current.length > 0 && (
    <section class="wrap section">
      <div class="section-head">
        <h2>Currently building</h2>
        <span class="meta">Updated {CURRENT_UPDATED}</span>
      </div>
      <div class="project-grid compact-grid">
        {current.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  <section class="wrap section">
    <div class="section-head">
      <h2>Selected projects</h2>
      <a href="/projects/">All projects &#8594;</a>
    </div>
    <div class="project-grid">
      {selected.map((p) => <ProjectCard project={p} featured />)}
    </div>
  </section>

  {also.length > 0 && (
    <section class="wrap section">
      <div class="section-head">
        <h2>Also built</h2>
      </div>
      <div class="project-grid compact-grid">
        {also.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  <section class="wrap section">
    <div class="section-head">
      <h2>What I work in</h2>
    </div>
    <div class="stack">
      <div class="stack-line">
        <div class="k">Hardware</div>
        <div class="v">
          SystemVerilog<span class="sep">·</span>RTL design &amp; simulation<span class="sep">·</span>Xilinx
          Vivado<span class="sep">·</span>FPGA bring-up<span class="sep">·</span>KiCad PCB design
        </div>
      </div>
      <div class="stack-line">
        <div class="k">Software</div>
        <div class="v">C<span class="sep">·</span>Python<span class="sep">·</span>Java<span class="sep">·</span>Flask<span class="sep">·</span>FastAPI</div>
      </div>
      <div class="stack-line">
        <div class="k">Domains</div>
        <div class="v">
          Real-time DSP<span class="sep">·</span>computer architecture<span class="sep">·</span>embedded
          firmware<span class="sep">·</span>agent systems
        </div>
      </div>
    </div>
  </section>
</Base>
