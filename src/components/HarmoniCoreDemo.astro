<section class="wrap hc-demo" aria-labelledby="hc-demo-title">
  <div class="hc-demo-copy">
    <p class="eyebrow">HarmoniCore · interactive model</p>
    <h2 id="hc-demo-title">What does a ring modulator do?</h2>
    <p>
      It multiplies each audio sample by a generated oscillator. Change the carrier and
      watch a simple input waveform turn into the metallic output implemented in fixed-point
      RTL.
    </p>
    <div class="hc-control">
      <label for="carrier">Carrier frequency <output id="carrier-value">220 Hz</output></label>
      <input id="carrier" type="range" min="40" max="800" value="220" step="10" />
    </div>
    <div class="hc-actions">
      <button class="hc-button" id="hc-audio" type="button">Play audio</button>
      <button class="hc-button" id="hc-pause" type="button">Pause motion</button>
      <a class="more" href="/projects/harmonicore/">See the RTL and verification &#8594;</a>
    </div>
  </div>

  <div class="hc-scope">
    <div class="hc-trace">
      <span>INPUT</span>
      <svg viewBox="0 0 720 120" role="img" aria-label="Input audio waveform">
        <path class="grid" d="M0 30H720M0 60H720M0 90H720M120 0V120M240 0V120M360 0V120M480 0V120M600 0V120" />
        <path id="hc-input-wave" class="wave input-wave" d="" />
      </svg>
    </div>
    <div class="hc-trace">
      <span>Q1.23 OUTPUT</span>
      <svg viewBox="0 0 720 120" role="img" aria-label="Ring-modulated output waveform">
        <path class="grid" d="M0 30H720M0 60H720M0 90H720M120 0V120M240 0V120M360 0V120M480 0V120M600 0V120" />
        <path id="hc-output-wave" class="wave output-wave" d="" />
      </svg>
    </div>
    <p class="hc-caption">
      Generated tone through the RTL arithmetic model · 24-bit Q1.23 · volume kept low
    </p>
  </div>
</section>

<script>
  const carrier = document.querySelector('#carrier');
  const carrierValue = document.querySelector('#carrier-value');
  const inputPath = document.querySelector('#hc-input-wave');
  const outputPath = document.querySelector('#hc-output-wave');
  const pause = document.querySelector('#hc-pause');
  const audio = document.querySelector('#hc-audio');

  if (
    carrier instanceof HTMLInputElement &&
    carrierValue instanceof HTMLOutputElement &&
    inputPath instanceof SVGPathElement &&
    outputPath instanceof SVGPathElement &&
    pause instanceof HTMLButtonElement &&
    audio instanceof HTMLButtonElement
  ) {
    let running = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let phase = 0;
    let frame = 0;
    let audioContext: AudioContext | null = null;
    let audioSource: AudioBufferSourceNode | null = null;

    const q23 = (value) => {
      const max = 1 - 2 ** -23;
      const clipped = Math.max(-1, Math.min(max, value));
      return Math.round(clipped * 2 ** 23) / 2 ** 23;
    };

    const q23Sine = (turns) => {
      const wrapped = ((turns % 1) + 1) % 1;
      const phaseWord = Math.floor(wrapped * 2 ** 18);
      const quadrant = (phaseWord >> 16) & 0x3;
      let address = (phaseWord >> 10) & 0x3f;
      if (quadrant & 0x1) address = 0x3f - address;
      let oscillator = q23(Math.sin((address * Math.PI / 2) / 63));
      if (quadrant & 0x2) oscillator = -oscillator;
      return oscillator;
    };

    const pathFor = (fn) => {
      const points = 240;
      let d = '';
      for (let i = 0; i <= points; i += 1) {
        const x = (i / points) * 720;
        const y = 60 - fn(i / points) * 46;
        d += `${i === 0 ? 'M' : 'L'}${x.toFixed(2)} ${y.toFixed(2)}`;
      }
      return d;
    };

    const draw = () => {
      const carrierHz = Number(carrier.value);
      const windowSeconds = 0.025;
      carrierValue.value = `${carrierHz.toFixed(0)} Hz`;
      const source = (t) => {
        const seconds = t * windowSeconds;
        return (
          0.5 * Math.sin(2 * Math.PI * 110 * seconds + phase) +
          0.2 * Math.sin(2 * Math.PI * 220 * seconds + phase * 0.7) +
          0.1 * Math.sin(2 * Math.PI * 330 * seconds)
        );
      };
      inputPath.setAttribute('d', pathFor(source));
      outputPath.setAttribute(
        'd',
        pathFor((t) =>
          q23(q23(source(t)) * q23Sine(carrierHz * t * windowSeconds + phase / (2 * Math.PI)))
        )
      );
    };

    const stopAudio = () => {
      if (audioSource) {
        audioSource.stop();
        audioSource.disconnect();
        audioSource = null;
      }
      audio.textContent = 'Play audio';
      audio.setAttribute('aria-pressed', 'false');
    };

    const startAudio = async () => {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioContextClass) return;
      audioContext ||= new AudioContextClass();
      await audioContext.resume();
      if (audioSource) {
        audioSource.stop();
        audioSource.disconnect();
      }

      const duration = 2;
      const sampleRate = audioContext.sampleRate;
      const buffer = audioContext.createBuffer(1, duration * sampleRate, sampleRate);
      const samples = buffer.getChannelData(0);
      const carrierHz = Number(carrier.value);
      for (let i = 0; i < samples.length; i += 1) {
        const seconds = i / sampleRate;
        const input =
          0.5 * Math.sin(2 * Math.PI * 110 * seconds) +
          0.2 * Math.sin(2 * Math.PI * 220 * seconds) +
          0.1 * Math.sin(2 * Math.PI * 330 * seconds);
        samples[i] = 0.18 * q23(q23(input) * q23Sine(carrierHz * seconds));
      }

      const gain = audioContext.createGain();
      gain.gain.value = 1;
      audioSource = audioContext.createBufferSource();
      audioSource.buffer = buffer;
      audioSource.loop = true;
      audioSource.connect(gain).connect(audioContext.destination);
      audioSource.start();
      audio.textContent = 'Stop audio';
      audio.setAttribute('aria-pressed', 'true');
    };

    const tick = () => {
      if (running) phase = (phase + 0.0015) % 1;
      if (running || frame === 0) draw();
      frame = window.requestAnimationFrame(tick);
    };

    carrier.addEventListener('input', () => {
      draw();
      if (audioSource) void startAudio();
    });
    audio.addEventListener('click', () => {
      if (audioSource) stopAudio();
      else void startAudio();
    });
    pause.addEventListener('click', () => {
      running = !running;
      pause.textContent = running ? 'Pause motion' : 'Resume motion';
      pause.setAttribute('aria-pressed', String(!running));
      draw();
    });
    pause.setAttribute('aria-pressed', String(!running));
    audio.setAttribute('aria-pressed', 'false');
    if (!running) pause.textContent = 'Resume motion';
    window.addEventListener('pagehide', stopAudio, { once: true });
    tick();
  }
</script>

<style>
  .hc-demo {
    display: grid;
    grid-template-columns: minmax(240px, .72fr) minmax(0, 1.28fr);
    gap: clamp(28px, 5vw, 68px);
    padding-block: 42px;
    border-top: 1px solid var(--rule-2);
    border-bottom: 1px solid var(--rule-2);
  }
  .hc-demo-copy h2 {
    font-family: var(--f-display);
    font-size: clamp(31px, 4vw, 47px);
    font-weight: 400;
    line-height: 1.02;
  }
  .hc-demo-copy > p:not(.eyebrow) {
    color: var(--ink-2);
    margin: 15px 0 20px;
    font-size: var(--fs-sm);
  }
  .hc-control {
    display: grid;
    gap: 9px;
    margin: 20px 0 14px;
  }
  .hc-control label {
    display: flex;
    justify-content: space-between;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .hc-control output { color: var(--accent-ink); }
  .hc-control input { width: 100%; accent-color: var(--accent); }
  .hc-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .hc-button {
    border: 1px solid var(--rule-2);
    background: transparent;
    color: var(--ink-2);
    padding: 7px 10px;
    font: 11px var(--f-mono);
    cursor: pointer;
  }
  .hc-button:hover { border-color: var(--accent); color: var(--accent-ink); }
  .hc-demo .more { display: inline-block; font-family: var(--f-mono); font-size: 11px; }
  .hc-scope {
    min-width: 0;
    border: 1px solid var(--rule-2);
    background: var(--card);
    padding: 16px 18px 13px;
  }
  .hc-trace + .hc-trace { margin-top: 8px; }
  .hc-trace span, .hc-caption {
    font-family: var(--f-mono);
    color: var(--ink-3);
    font-size: 9px;
    letter-spacing: .1em;
  }
  .hc-trace svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid { fill: none; stroke: var(--rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .wave { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; }
  .input-wave { stroke: var(--ink-3); }
  .output-wave { stroke: var(--accent); }
  .hc-caption { margin: 7px 0 0; line-height: 1.5; }
  @media (max-width: 760px) {
    .hc-demo { grid-template-columns: 1fr; }
  }
</style>
